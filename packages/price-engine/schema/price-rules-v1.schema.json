{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://property-management-codex.local/schema/price-rules-v1.schema.json",
  "title": "Property Management Codex price rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rule_set", "listing_context", "base", "rules", "guardrails"],
  "properties": {
    "schema": { "const": "pmc.price-rules/v1" },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "effective_from"],
      "properties": {
        "id": { "$ref": "#/$defs/nonemptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "effective_from": { "$ref": "#/$defs/date" }
      }
    },
    "listing_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "timezone", "jurisdiction"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "currency_decimals": { "type": "integer", "minimum": 0, "maximum": 6, "default": 2 },
        "timezone": { "$ref": "#/$defs/nonemptyString" },
        "jurisdiction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country"],
          "properties": {
            "country": { "$ref": "#/$defs/nonemptyString" },
            "subdivision": { "$ref": "#/$defs/nonemptyString" },
            "municipality": { "$ref": "#/$defs/nonemptyString" }
          }
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "weekend", "weekend_days"],
      "properties": {
        "weekday": { "$ref": "#/$defs/money" },
        "weekend": { "$ref": "#/$defs/money" },
        "weekend_days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/weekday" }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rule" }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_floor", "hard_ceiling", "maximum_automatic_change_percent", "rounding"],
      "properties": {
        "hard_floor": { "$ref": "#/$defs/money" },
        "hard_ceiling": { "$ref": "#/$defs/money" },
        "maximum_automatic_change_percent": { "$ref": "#/$defs/decimal" },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "increment"],
          "properties": {
            "method": { "enum": ["nearest", "up", "down"] },
            "increment": { "$ref": "#/$defs/money" }
          }
        }
      }
    }
  },
  "$defs": {
    "nonemptyString": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "monthDay": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "money": { "$ref": "#/$defs/decimal" },
    "weekday": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["date"],
          "properties": { "date": { "$ref": "#/$defs/date" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["date_range"],
          "properties": {
            "date_range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "through"],
              "properties": { "from": { "$ref": "#/$defs/date" }, "through": { "$ref": "#/$defs/date" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["annually"],
          "properties": {
            "annually": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "through"],
              "properties": { "from": { "$ref": "#/$defs/monthDay" }, "through": { "$ref": "#/$defs/monthDay" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["weekday"],
          "properties": { "weekday": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/weekday" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stay_nights"],
          "properties": {
            "stay_nights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "exactly": { "type": "integer", "minimum": 1 },
                "at_least": { "type": "integer", "minimum": 1 },
                "fewer_than": { "type": "integer", "minimum": 2 }
              },
              "oneOf": [
                { "required": ["exactly"], "not": { "anyOf": [{ "required": ["at_least"] }, { "required": ["fewer_than"] }] } },
                { "required": ["at_least"], "not": { "required": ["exactly"] } }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key"],
              "properties": {
                "key": { "$ref": "#/$defs/nonemptyString" },
                "days_before": { "type": "integer", "minimum": 0, "maximum": 366 },
                "days_after": { "type": "integer", "minimum": 0, "maximum": 366 },
                "accepted_status": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["calculated", "tentative", "confirmed", "stale"] }
                }
              }
            }
          }
        }
      ]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "set_nightly": { "$ref": "#/$defs/money" },
        "set_final_nightly": { "$ref": "#/$defs/money" },
        "adjust_nightly_percent": { "$ref": "#/$defs/decimal" },
        "adjust_nightly_amount": { "$ref": "#/$defs/money" },
        "stay_discount_percent": { "$ref": "#/$defs/decimal" },
        "nightly_floor": { "$ref": "#/$defs/money" },
        "nightly_ceiling": { "$ref": "#/$defs/money" },
        "minimum_stay": { "type": "integer", "minimum": 1 },
        "maximum_stay": { "type": "integer", "minimum": 1 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "layer", "group", "priority", "stacking", "when", "apply"],
      "properties": {
        "id": { "$ref": "#/$defs/nonemptyString" },
        "name": { "$ref": "#/$defs/nonemptyString" },
        "layer": { "enum": ["season", "weekday_channel", "event", "demand", "manual_override", "stay"] },
        "group": { "$ref": "#/$defs/nonemptyString" },
        "priority": { "type": "integer" },
        "stacking": { "enum": ["exclusive", "compound"] },
        "when": { "$ref": "#/$defs/condition" },
        "apply": { "$ref": "#/$defs/actions" },
        "suppresses": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonemptyString" } }
      }
    }
  }
}
